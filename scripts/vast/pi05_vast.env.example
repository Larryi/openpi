# Copy to a private file outside Git, fill secrets, then `source` it.
# Never commit HF_TOKEN, WANDB_API_KEY, VAST_API_KEY, or SSH private keys.

export HF_TOKEN="<hf-token>"
export MODEL_REPO="your-hf-user/kuavo-pi05-task1-a100x4"
# Public model output avoids private-storage quota. The input dataset remains private and still requires HF_TOKEN.
export MODEL_REPO_PRIVATE="0"

# task1/task2 are Kuavo; so101_60/so101_90 are the two independent SO-101 comparisons.
export ROBOT_TASK="task1"
export DATASET_REPO="larryi/kuavo-task1-345"

# SO-101 example (these repositories are the pipeline defaults):
# export ROBOT_TASK="so101_60"
# export DATASET_REPO="larryi/so101_grab_blue_pen_60"
# export ROBOT_TASK="so101_90"
# export DATASET_REPO="larryi/so101_grab_blue_pen_90"

# Vast persistent workspace. Keep caches, data, checkpoints, and logs under this mount.
export WORK_ROOT="/workspace/kuavo_pi05"
export CODE_DIR="/workspace/kuavo_pi05/openpi-kuavo"

# Safe default: prepare + full norm + real-model 10-step smoke. Full training requires CONFIRM_FULL_TRAIN=YES.
export PIPELINE_MODE="smoke"
export CONFIRM_FULL_TRAIN="NO"

export GPU_IDS="0,1,2,3"
export GPU_COUNT="4"
export FSDP_DEVICES="4"
export SMOKE_GLOBAL_BATCH_SIZE="4"
export TRAIN_GLOBAL_BATCH_SIZE="32"
export NUM_WORKERS="8"
export NUM_TRAIN_STEPS="30000"
export SAVE_INTERVAL="1000"
export LOG_INTERVAL="20"
# A very large keep period lets Orbax max_to_keep=1 retain only the latest finalized checkpoint.
export KEEP_PERIOD="1000000000"
export RUN_ID="task1_pi05_a100x4_v1"

# Public official JAX base. Set this to a local .../params directory if it was copied to the Vast volume.
export BASE_PARAMS="gs://openpi-assets/checkpoints/pi05_base/params"
export PALIGEMMA_REPO="google/paligemma-3b-pt-224"
export MIN_FREE_GB="250"
export REQUIRE_GPU_NAME="A100"
export MIN_GPU_MEMORY_MB="79000"
export MIN_GPU_FREE_MB="70000"
export PYTHON_VERSION="3.11"
export EMA_DECAY="0.99"
export XLA_PYTHON_CLIENT_PREALLOCATE="true"
export XLA_PYTHON_CLIENT_MEM_FRACTION="0.90"
export REMAT_POLICY="nothing_saveable"

# Single RTX PRO 6000 Blackwell Workstation Edition profile (96 GB). This keeps multi-GPU support intact;
# use these values instead of the A100 block above when renting one workstation GPU.
# export GPU_IDS="0"
# export GPU_COUNT="1"
# export FSDP_DEVICES="1"
# export SMOKE_GLOBAL_BATCH_SIZE="1"
# export TRAIN_GLOBAL_BATCH_SIZE="1"
# export REQUIRE_GPU_NAME="RTX PRO 6000"
# export MIN_GPU_MEMORY_MB="90000"
# export MIN_GPU_FREE_MB="88000"
# export CUDA_NVCC_VERSION="auto"
# export EMA_DECAY="None"
# export REMAT_POLICY="dots_with_no_batch_dims_saveable"

# Optional experiment tracking and lifecycle controls.
export WANDB_API_KEY=""
export WANDB_PROJECT="openpi-kuavo"
export AUTO_UPLOAD="1"
export OVERWRITE="0"
export RESUME="0"
export SERVERCHAN_SENDKEY=""
export AUTO_STOP_INSTANCE="0"
export AUTO_STOP_ON_FAILURE="0"
# If automatic stop is enabled, this prevents an HF quota/upload error from leaving the instance unattended.
export AUTO_STOP_ON_UPLOAD_FAILURE="1"
export VAST_INSTANCE_ID=""
export VAST_API_KEY=""
