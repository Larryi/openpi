# Copy this file outside the Git worktree, chmod 600, fill secrets/model repo, then source it.
# Never commit HF_TOKEN, WANDB_API_KEY, VAST_API_KEY, or SSH private keys.

export HF_TOKEN=""
export MODEL_REPO=""
# Keep existing SO-101 behavior private unless explicitly changed to 0.
export MODEL_REPO_PRIVATE="1"

# For the 90-episode comparison, change all three values together as shown below.
export ROBOT_TASK="so101_60"
export DATASET_REPO="larryi/so101_grab_blue_pen_60"
export RUN_ID="so101_60_pi05_rtxpro6000_smoke_v1"
# export ROBOT_TASK="so101_90"
# export DATASET_REPO="larryi/so101_grab_blue_pen_90"
# export RUN_ID="so101_90_pi05_rtxpro6000_smoke_v1"

export WORK_ROOT="/workspace/so101_pi05"
export CODE_DIR="/workspace/so101_pi05/openpi-kuavo"

# Fail-closed default: full setup/norm validation plus a real Pi0.5 10-step smoke.
export PIPELINE_MODE="smoke"
export CONFIRM_FULL_TRAIN="NO"

# Single NVIDIA RTX PRO 6000 Blackwell Workstation Edition (96 GB).
export GPU_IDS="0"
export GPU_COUNT="1"
export FSDP_DEVICES="1"
export SMOKE_GLOBAL_BATCH_SIZE="1"
export TRAIN_GLOBAL_BATCH_SIZE="1"
export REQUIRE_GPU_NAME="RTX PRO 6000"
export MIN_GPU_MEMORY_MB="90000"
export MIN_GPU_FREE_MB="88000"
export CUDA_NVCC_VERSION="12.8.93"
export PYTHON_VERSION="3.11"

# Full-parameter AdamW is retained. Disable the full-model EMA copy on one GPU and reserve 90% of VRAM for JAX.
export EMA_DECAY="None"
export XLA_PYTHON_CLIENT_PREALLOCATE="true"
export XLA_PYTHON_CLIENT_MEM_FRACTION="0.90"
# Balanced speed/memory profile: save expensive dot outputs instead of recomputing all of them in backward.
export REMAT_POLICY="dots_with_no_batch_dims_saveable"

export NUM_WORKERS="8"
export NUM_TRAIN_STEPS="30000"
export SMOKE_STEPS="10"
export SAVE_INTERVAL="1000"
export LOG_INTERVAL="20"
# Orbax max_to_keep=1; this avoids preserving ordinary milestone checkpoints.
export KEEP_PERIOD="1000000000"
export MIN_FREE_GB="50"

export BASE_PARAMS="gs://openpi-assets/checkpoints/pi05_base/params"
export PALIGEMMA_REPO="google/paligemma-3b-pt-224"
export UV_DEFAULT_INDEX="https://pypi.org/simple"

export WANDB_API_KEY=""
export WANDB_PROJECT="openpi-so101"
export AUTO_UPLOAD="1"
export OVERWRITE="0"
export RESUME="0"

# Optional final success/failure notification. Keep the SendKey only in this private file.
export SERVERCHAN_SENDKEY=""

# Automatic stop is off by default. For a proven full-training workflow, set it to 1 and provide a scoped Vast key.
# By default, failed runs stay online for diagnosis; set AUTO_STOP_ON_FAILURE=1 only if that is intentional.
export AUTO_STOP_INSTANCE="0"
export AUTO_STOP_ON_FAILURE="0"
export AUTO_STOP_ON_UPLOAD_FAILURE="0"
export VAST_INSTANCE_ID=""
export VAST_API_KEY=""
